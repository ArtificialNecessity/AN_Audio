<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)../../AN.Audio.Build.props" />

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>AN.Audio</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>ArtificialNecessity.Audio.Common</PackageId>
    <Description>Shared PCM vocabulary for the ArtificialNecessity.Audio packages: AudioFormat, SampleFormat, AudioChannelMask, AudioBufferView, AudioSampleConvert. No OS, no I/O, no decoders.</Description>
    <PackageReadmeFile>README-nuget.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/ArtificialNecessity/AN_Audio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ArtificialNecessity/AN_Audio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Authors>David Jeske</Authors>
    <Copyright>(C)opyright David Jeske 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AN.Audio.Common.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../README-nuget.md" Pack="true" PackagePath="/" />
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE.txt" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>