<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(MSBuildThisFileDirectory)../../AN.Audio.Build.props" />

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AN.Audio.Midi</RootNamespace>
    <!-- Packed into ArtificialNecessity.Audio by src/AN.Audio.Package (SPEC-30 D21). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AN.Audio.Midi.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AN.Audio\AN.Audio.csproj" />
  </ItemGroup>

</Project>