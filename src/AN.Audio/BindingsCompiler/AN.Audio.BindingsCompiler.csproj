<Project Sdk="Microsoft.NET.Sdk">
  <!-- Spec 71: build-only tool. `extract` reads an SDK on disk (explicit, developer-run); `normalize` runs during AN.Audio's build.
       Never linked into AN.Audio.dll, never packed. -->
  <Import Project="$(MSBuildThisFileDirectory)../../../AN.Audio.Build.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>AN.Audio.BindingsCompiler</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ArtificialNecessity.YeetJson" Version="$(ANYeetJsonVersion)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AN.Audio.Tests" />
  </ItemGroup>
</Project>